{
  "name": "@australiangreens/ag-error-jest",
  "version": "0.3.0",
  "description": "Provides jest matchers to simplify testing of subclasses of AgErrors from the ag-error package",
  "author": "The Australian Greens <webops@greens.org.au>",
  "contributors": [
    "Anthony Blond <anthony@unfinishedteleporter.com>"
  ],
  "license": "MIT",
  "homepage": "https://github.com/australiangreens/ag-error-jest#readme",
  "repository": "github:australiangreens/ag-error-jest",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "types": "./dist/esm/index.d.ts",
  "sideEffects": [
    "dist/cjs/jest/index.js",
    "dist/esm/jest/index.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build:esm": "tsc --project ./tsconfig.json",
    "build:cjs": "tsc --project ./tsconfig-cjs.json",
    "build": "pnpm build:esm && pnpm build:cjs && ./fixup.sh",
    "build:force": "rm -rf ./dist && pnpm build:esm && pnpm build:cjs && ./fixup.sh",
    "lint": "eslint --max-warnings 0 src",
    "prepublishOnly": "pnpm lint && pnpm build:force",
    "release": "node scripts/release.js",
    "ship": "pnpm publish --no-git-checks"
  },
  "peerDependencies": {
    "@australiangreens/ag-error": "^0.2.0",
    "jest": ">=29"
  },
  "devDependencies": {
    "@australiangreens/ag-error": "^0.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.36.0",
    "jest": "^30.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
