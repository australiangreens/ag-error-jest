{
  "compilerOptions": {
    "rootDir": "./src",
    "module": "ES2020",
    "target": "ES2020",
    "outDir": "dist/esm",
    "esModuleInterop": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
